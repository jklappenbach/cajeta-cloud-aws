{
    // cajeta-cloud-aws — the AWS adapters for dev.cajeta.cloud's ports: the
    // Cognito user-pool identity adapter and the S3 object-store adapter, over
    // cajeta-http, signed with SigV4 (cajeta-cloud-adapters spec §2).
    //
    // Capabilities: `network` for the service endpoints, `env` and
    // `filesystem` for the credential chain (AWS_* variables, then
    // ~/.aws/credentials; spec §2.1).

    "details": {
        "name":               "dev.cajeta.cloud.aws",
        "version":            "0.1.0",
        "description":        "cajeta-cloud-aws — Cognito identity and S3 object-store adapters for dev.cajeta.cloud, SigV4-signed over cajeta-http",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        "toolchain": {
            "version": "0.46.3"
        },

        "capabilities": ["env", "filesystem", "network"],

        // codec 0.9.1 (the XML reader) and crypto 0.2.0 (Srp, for Cognito) are
        // direct dependencies. http 0.9.1 asks for codec 0.8.7 and crypto
        // 0.1.0, and cloud 0.4.1 for crypto 0.1.0; since cajeta 0.46.3 a bare
        // version is a floor within its major, so the resolver takes the
        // highest of the floors.
        "dependencies": {
            "dev.cajeta.cloud":  "0.4.1",
            "dev.cajeta.http":   "0.9.1",
            "dev.cajeta.codec":  "0.9.1",
            "dev.cajeta.crypto": "0.2.0"
        },

        "dev-dependencies": {
            "dev.cajeta.unit": "0.3.6"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        "build": {
            "source-root": "src/main/cajeta",
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's test suite",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "release": {
            "description": "Release build of the .cja",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Remove build outputs",
            "actions": [
                { "action": "exec", "command": "rm", "args": ["-rf", "build"] }
            ]
        }
    }
}
