package dev.cajeta.cloud.aws.selftest;

import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.Skip;
import dev.cajeta.cloud.Capabilities;
import dev.cajeta.cloud.Caps;
import dev.cajeta.cloud.testkit.ObjectStoreContract;
import dev.cajeta.cloud.aws.AwsConfig;
import dev.cajeta.cloud.aws.AwsConfigurationException;
import dev.cajeta.cloud.aws.S3ObjectStore;

/**
 * Building an S3ObjectStore from the AWS chain (adapters spec 2.1, 2.4), and
 * the object-store conformance suite against a real bucket (plan 4.1.5),
 * opt-in through CAJETA_AWS_TEST_BUCKET with the chain's region and
 * credentials (CAJETA_AWS_TEST_S3_ENDPOINT and CAJETA_AWS_TEST_S3_PATH_STYLE
 * for an S3-compatible service).
 */
public class S3ConnectTest {

    public S3ConnectTest() {
        return;
    }

    @Test
    public void connectNamesWhatTheChainLacks() {
        System.env.set("AWS_ACCESS_KEY_ID", "");
        System.env.set("AWS_SECRET_ACCESS_KEY", "");
        System.env.set("AWS_PROFILE", "");
        System.env.set("AWS_REGION", "");
        System.env.set("AWS_DEFAULT_REGION", "");
        System.env.set("AWS_SHARED_CREDENTIALS_FILE", "/nonexistent/cajeta-aws/credentials");
        String message = "";
        try {
            S3ObjectStore s #= S3ObjectStore.connect("examplebucket", null, false, null);
        } catch (AwsConfigurationException e) {
            message = "" + e.message;
        }
        Assert.isTrue(message.indexOf("AWS_ACCESS_KEY_ID") >= 0L || message.indexOf("AWS_REGION") >= 0L);
        return;
    }

    @Test
    public void connectWithAConfigBuildsAStoreWithoutCallingAws() {
        AwsConfig config = heap AwsConfig("AKIAIOSFODNN7EXAMPLE",
            "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY", null, "eu-west-2");
        S3ObjectStore s #= S3ObjectStore.connect("examplebucket", "http://localhost:9000", true, config);
        Capabilities c = s.capabilities();
        String name #= c.adapterName();
        Assert.equals("s3", name);
        Assert.isTrue(c.supports(Caps.COND_PUT_CREATE()));
        Assert.isTrue(c.supports(Caps.MULTIPART()));
        Assert.isTrue(s.stats().requests() == 0L);
        return;
    }

    @Test
    public void theObjectStoreContractHoldsAgainstARealBucket() {
        String bucket = System.env.get("CAJETA_AWS_TEST_BUCKET");
        if (bucket == null || bucket.byteLength() == 0) {
            Skip.because("CAJETA_AWS_TEST_BUCKET is not set; no S3 bucket to test against");
        }
        String endpoint = System.env.get("CAJETA_AWS_TEST_S3_ENDPOINT");
        if (endpoint != null && endpoint.byteLength() == 0) endpoint = null;
        String ps = System.env.get("CAJETA_AWS_TEST_S3_PATH_STYLE");
        boolean pathStyle = ps != null && ps.equals("1");
        S3ObjectStore s #= S3ObjectStore.connect(bucket, endpoint, pathStyle, null);
        ObjectStoreContract.verify(s, "cajeta-conformance/");
        return;
    }
}
