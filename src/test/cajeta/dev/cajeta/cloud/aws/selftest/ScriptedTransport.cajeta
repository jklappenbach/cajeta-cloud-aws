package dev.cajeta.cloud.aws.selftest;

import cajeta.lang.String;
import cajeta.collection.ArrayList;
import dev.cajeta.cloud.aws.CognitoReply;
import dev.cajeta.cloud.aws.CognitoTransport;

/**
 * A CognitoTransport that answers from a script, in order, and records each
 * request's operation, body and whether it was signed. The replies are the
 * shapes the cognito-idp API reference documents: a 200 with the operation's
 * response document, or a 400 (500 for InternalErrorException) whose `__type`
 * names the exception.
 */
public final class ScriptedTransport implements CognitoTransport {
    ArrayList<String> replyBodies;
    ArrayList<int32> replyStatus;
    ArrayList<String> ops;
    ArrayList<String> bodies;
    ArrayList<int32> signedFlags;
    int32 next;

    public ScriptedTransport() {
        this.replyBodies = heap ArrayList<String>();
        this.replyStatus = heap ArrayList<int32>();
        this.ops = heap ArrayList<String>();
        this.bodies = heap ArrayList<String>();
        this.signedFlags = heap ArrayList<int32>();
        this.next = 0;
        return;
    }

    public void reply(int32 status, String body) {
        String b = "" + body;
        this.replyBodies.add(#b);
        this.replyStatus.add(status);
        return;
    }

    public void error(String type, String message) {
        int32 status = 400;
        if (type.equals("InternalErrorException")) status = 500;
        this.reply(status, "{\"__type\":\"" + type + "\",\"message\":\"" + message + "\"}");
        return;
    }

    public int32 calls() { return this.ops.count(); }
    public String opAt(int32 i) { return this.ops.get(i); }
    public String bodyAt(int32 i) { return this.bodies.get(i); }
    public boolean signedAt(int32 i) { return this.signedFlags.get(i) == 1; }

    public #CognitoReply send(String operation, String body, boolean signed) {
        String o = "" + operation;
        String b = "" + body;
        this.ops.add(#o);
        this.bodies.add(#b);
        int32 s = 0;
        if (signed) s = 1;
        this.signedFlags.add(s);
        int32 i = this.next;
        this.next = this.next + 1;
        if (i >= this.replyBodies.count()) {
            return heap CognitoReply(500, "{\"__type\":\"ScriptExhausted\",\"message\":\"no scripted reply\"}");
        }
        return heap CognitoReply(this.replyStatus.get(i), this.replyBodies.get(i));
    }
}
