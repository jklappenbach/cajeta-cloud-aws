package dev.cajeta.cloud.aws.selftest;

import cajeta.lang.String;
import cajeta.io.file.File;
import dev.cajeta.unit.Assert;
import dev.cajeta.cloud.aws.AwsConfig;
import dev.cajeta.cloud.aws.AwsConfigurationException;
import dev.cajeta.cloud.aws.AwsCredentials;
import dev.cajeta.cloud.aws.CredentialChain;

/**
 * The credential chain (plan 2.1.2, spec 2.1): an AwsConfig component wins over
 * the environment, which wins over the shared credentials file with
 * AWS_PROFILE. A missing key fails naming the three steps, and no message
 * carries a secret. Each test sets the variables it needs and restores them;
 * an empty variable counts as unset. Credentials files are written under
 * CAJETA_AWS_TEST_TMP, which run-tests.sh exports.
 */
public class CredentialChainTest {

    public CredentialChainTest() {
        return;
    }

    @Test
    public void anAwsConfigWinsOverTheEnvironment() {
        CredentialChainTest.clearAll();
        System.env.set("AWS_ACCESS_KEY_ID", "AKIDFROMENV");
        System.env.set("AWS_SECRET_ACCESS_KEY", "secret-from-env");
        AwsConfig config = heap AwsConfig("AKIDFROMCONFIG", "secret-from-config", null, "eu-west-1");
        AwsCredentials c #= CredentialChain.resolve(config);
        Assert.equals("AKIDFROMCONFIG", c.accessKeyId());
        Assert.equals("secret-from-config", c.secretAccessKey());
        CredentialChainTest.clearAll();
        return;
    }

    @Test
    public void theEnvironmentWinsOverTheCredentialsFile() {
        CredentialChainTest.clearAll();
        String file #= CredentialChainTest.writeFile("env-wins",
            "[default]\naws_access_key_id = AKIDFROMFILE\naws_secret_access_key = secret-from-file\n");
        System.env.set("AWS_SHARED_CREDENTIALS_FILE", file);
        System.env.set("AWS_ACCESS_KEY_ID", "AKIDFROMENV");
        System.env.set("AWS_SECRET_ACCESS_KEY", "secret-from-env");
        System.env.set("AWS_SESSION_TOKEN", "token-from-env");
        AwsCredentials c #= CredentialChain.resolve(null);
        Assert.equals("AKIDFROMENV", c.accessKeyId());
        Assert.isTrue(c.hasSessionToken());
        Assert.equals("token-from-env", c.sessionToken());
        CredentialChainTest.clearAll();
        return;
    }

    @Test
    public void theCredentialsFileHonoursAwsProfile() {
        CredentialChainTest.clearAll();
        String file #= CredentialChainTest.writeFile("profile",
            "# a comment\n[default]\naws_access_key_id=AKIDDEFAULT\naws_secret_access_key=secret-default\n\n"
            + "[work]\n  aws_access_key_id = AKIDWORK  \naws_secret_access_key = secret-work\n"
            + "aws_session_token = token-work\n");
        System.env.set("AWS_SHARED_CREDENTIALS_FILE", file);
        AwsCredentials d #= CredentialChain.resolve(null);
        Assert.equals("AKIDDEFAULT", d.accessKeyId());
        Assert.isFalse(d.hasSessionToken());
        System.env.set("AWS_PROFILE", "work");
        AwsCredentials w #= CredentialChain.resolve(null);
        Assert.equals("AKIDWORK", w.accessKeyId());
        Assert.equals("secret-work", w.secretAccessKey());
        Assert.equals("token-work", w.sessionToken());
        CredentialChainTest.clearAll();
        return;
    }

    @Test
    public void aMissingKeyNamesTheThreeStepsAndNoSecret() {
        CredentialChainTest.clearAll();
        // A secret with no key id must not resolve, and must not be echoed.
        System.env.set("AWS_SECRET_ACCESS_KEY", "TOPSECRETVALUE");
        System.env.set("AWS_SHARED_CREDENTIALS_FILE", "/nonexistent/cajeta-aws/credentials");
        String message #= CredentialChainTest.failureOf(null);
        Assert.isTrue(message.indexOf("AwsConfig") >= 0L);
        Assert.isTrue(message.indexOf("AWS_ACCESS_KEY_ID") >= 0L);
        Assert.isTrue(message.indexOf("/nonexistent/cajeta-aws/credentials") >= 0L);
        Assert.isTrue(message.indexOf("TOPSECRETVALUE") < 0L);
        CredentialChainTest.clearAll();
        return;
    }

    @Test
    public void aProfileWithoutASecretNamesTheProfileAndNoKey() {
        CredentialChainTest.clearAll();
        String file #= CredentialChainTest.writeFile("half",
            "[ops]\naws_access_key_id = AKIDHALFPROFILE\n");
        System.env.set("AWS_SHARED_CREDENTIALS_FILE", file);
        System.env.set("AWS_PROFILE", "ops");
        String message #= CredentialChainTest.failureOf(null);
        Assert.isTrue(message.indexOf("'ops'") >= 0L);
        Assert.isTrue(message.indexOf("aws_secret_access_key") >= 0L);
        CredentialChainTest.clearAll();
        return;
    }

    @Test
    public void theRegionComesFromTheConfigThenTheEnvironment() {
        CredentialChainTest.clearAll();
        AwsConfig config = heap AwsConfig("AKID", "secret", null, "eu-west-1");
        String r1 #= CredentialChain.region(config);
        Assert.equals("eu-west-1", r1);
        System.env.set("AWS_REGION", "us-west-2");
        AwsConfig bare = heap AwsConfig("AKID", "secret", null, null);
        String r2 #= CredentialChain.region(bare);
        Assert.equals("us-west-2", r2);
        String r3 #= CredentialChain.region(null);
        Assert.equals("us-west-2", r3);
        CredentialChainTest.clearAll();
        return;
    }

    // The message of the exception resolve() throws, or a failed assertion.
    private static #String failureOf(AwsConfig config) {
        try {
            AwsCredentials c #= CredentialChain.resolve(config);
        } catch (AwsConfigurationException e) {
            return "" + e.message;
        }
        Assert.fail("CredentialChain.resolve resolved credentials where none were configured");
        return "";
    }

    private static void clearAll() {
        System.env.set("AWS_ACCESS_KEY_ID", "");
        System.env.set("AWS_SECRET_ACCESS_KEY", "");
        System.env.set("AWS_SESSION_TOKEN", "");
        System.env.set("AWS_PROFILE", "");
        System.env.set("AWS_REGION", "");
        System.env.set("AWS_DEFAULT_REGION", "");
        System.env.set("AWS_SHARED_CREDENTIALS_FILE", "/nonexistent/cajeta-aws/credentials");
        return;
    }

    private static #String writeFile(String name, String text) {
        String dir = System.env.get("CAJETA_AWS_TEST_TMP");
        if (dir == null) {
            Assert.fail("CAJETA_AWS_TEST_TMP is not set; run through run-tests.sh");
        }
        String path #= dir + "/credentials-" + name;
        int32 n = text.byteLength();
        int8[] bytes = heap int8[n];
        for (int32 i = 0; i < n; i++) bytes[i] = text.byteAt(i);
        File.writeAllBytes(path, bytes, (int64) n);
        return path;
    }
}
