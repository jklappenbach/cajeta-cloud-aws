package dev.cajeta.cloud.aws;

import cajeta.lang.String;
import cajeta.lang.StringBuilder;
import cajeta.io.file.File;

/**
 * Where an adapter's key comes from (spec 2.1), first match wins:
 *
 * 1. an `AwsConfig` the application declares;
 * 2. the environment: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, optional
 *    AWS_SESSION_TOKEN;
 * 3. the shared credentials file, AWS_SHARED_CREDENTIALS_FILE or
 *    ~/.aws/credentials, profile AWS_PROFILE or "default".
 *
 * Instance and container metadata credentials are a later step after these.
 * An empty variable counts as unset. When nothing yields a key, `resolve`
 * throws `AwsConfigurationException` naming every step and why it gave
 * nothing; no message ever carries a secret or a token.
 */
public final class CredentialChain {

    public static #AwsCredentials resolve(AwsConfig config) {
        StringBuilder why = heap StringBuilder();

        // 1. The application's own configuration.
        if (config == null) {
            why.append("(1) an AwsConfig component: none declared; ");
        } else if (CredentialChain.blank(config.accessKeyId())
                   || CredentialChain.blank(config.secretAccessKey())) {
            why.append("(1) an AwsConfig component: declared without an access key id and secret; ");
        } else {
            return heap AwsCredentials(config.accessKeyId(), config.secretAccessKey(),
                CredentialChain.orNull(config.sessionToken()));
        }

        // 2. The environment.
        String id #= CredentialChain.env("AWS_ACCESS_KEY_ID");
        String secret #= CredentialChain.env("AWS_SECRET_ACCESS_KEY");
        if (id != null && secret != null) {
            return heap AwsCredentials(id, secret, CredentialChain.env("AWS_SESSION_TOKEN"));
        }
        if (id == null) {
            why.append("(2) the environment: AWS_ACCESS_KEY_ID is not set; ");
        } else {
            why.append("(2) the environment: AWS_ACCESS_KEY_ID is set but AWS_SECRET_ACCESS_KEY is not; ");
        }

        // 3. The shared credentials file.
        String path #= CredentialChain.credentialsPath();
        String profile #= CredentialChain.profileName();
        int8[] bytes #= File.readAllBytes(path);
        if (bytes == null) {
            why.append("(3) the shared credentials file " + path + ": not readable");
        } else {
            int32 n = (int32) bytes.count();
            String text = heap String(#bytes, n);
            String fid = null;
            String fsecret = null;
            String ftoken = null;
            boolean seen = false;
            boolean inProfile = false;
            int64 at = 0L;
            int64 len = text.byteLength();
            while (at < len) {
                int64 nl = text.indexOfFrom("\n", at);
                if (nl < 0L) nl = len;
                String raw #= text.substring((int32) at, (int32) nl);
                String line #= raw.trim();
                at = nl + 1L;
                int32 ll = line.byteLength();
                if (ll == 0) continue;
                int8 first = line.byteAt(0);
                if (first == (int8) 35 || first == (int8) 59) continue;          // # ;
                if (first == (int8) 91 && line.byteAt(ll - 1) == (int8) 93) {   // [ ]
                    String inner #= line.substring(1, ll - 1);
                    String name #= inner.trim();
                    inProfile = name.equals(profile) || name.equals("profile " + profile);
                    if (inProfile) seen = true;
                    continue;
                }
                if (!inProfile) continue;
                int64 eq = line.indexOf("=");
                if (eq < 0L) continue;
                String k0 #= line.substring(0, (int32) eq);
                String k1 #= k0.trim();
                String key #= k1.toLowerCase();
                String v0 #= line.substring((int32) (eq + 1L), ll);
                String value #= v0.trim();
                if (key.equals("aws_access_key_id")) fid #= value;
                else if (key.equals("aws_secret_access_key")) fsecret #= value;
                else if (key.equals("aws_session_token")) ftoken #= value;
            }
            if (!CredentialChain.blank(fid) && !CredentialChain.blank(fsecret)) {
                return heap AwsCredentials(fid, fsecret, CredentialChain.orNull(ftoken));
            }
            why.append("(3) the shared credentials file " + path + ", profile '" + profile + "': ");
            if (!seen) {
                why.append("no such profile");
            } else if (CredentialChain.blank(fid)) {
                why.append("no aws_access_key_id");
            } else {
                why.append("no aws_secret_access_key");
            }
        }
        String steps #= why.toString();
        throw heap AwsConfigurationException("no AWS credentials. Tried, in order: " + steps);
    }

    /** The region: the AwsConfig's, else AWS_REGION, else AWS_DEFAULT_REGION. */
    public static #String region(AwsConfig config) {
        if (config != null && !CredentialChain.blank(config.region())) {
            return "" + config.region();
        }
        String r #= CredentialChain.env("AWS_REGION");
        if (r != null) return "" + r;
        String d #= CredentialChain.env("AWS_DEFAULT_REGION");
        if (d != null) return "" + d;
        throw heap AwsConfigurationException("no AWS region. Tried, in order: "
            + "(1) an AwsConfig component: no region; "
            + "(2) the environment: AWS_REGION and AWS_DEFAULT_REGION are not set");
    }

    // AWS_SHARED_CREDENTIALS_FILE, else $HOME/.aws/credentials.
    private static #String credentialsPath() {
        String f #= CredentialChain.env("AWS_SHARED_CREDENTIALS_FILE");
        if (f != null) return "" + f;
        String home #= CredentialChain.env("HOME");
        if (home == null) return "" + "~/.aws/credentials";
        return home + "/.aws/credentials";
    }

    private static #String profileName() {
        String p #= CredentialChain.env("AWS_PROFILE");
        if (p != null) return "" + p;
        return "" + "default";
    }

    // The variable's value, or null when it is unset or empty.
    private static #String env(String name) {
        String v #= System.env.get(name);
        if (v == null || v.byteLength() == 0) return null;
        return #v;
    }

    private static boolean blank(String s) {
        return s == null || s.byteLength() == 0;
    }

    private static String orNull(String s) {
        if (CredentialChain.blank(s)) return null;
        return s;
    }
}
