package dev.cajeta.cloud.aws;

import cajeta.error.RecoverableException;
import cajeta.lang.String;

/**
 * Startup refused: no step of the credential chain yields a key, or no region
 * is configured. The message names each step tried and why it gave nothing,
 * never a credential value. A deployment error, not an operation failure.
 */
public class AwsConfigurationException extends RecoverableException {
    public AwsConfigurationException(String message) {
        this.message = "" + message;
        this.cause = 0;
    }
}
