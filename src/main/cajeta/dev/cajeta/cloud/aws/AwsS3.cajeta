package dev.cajeta.cloud.aws;

import cajeta.lang.String;
import dev.cajeta.cloud.s3.S3Config;
import dev.cajeta.cloud.s3.S3Credentials;
import dev.cajeta.cloud.s3.S3Endpoint;
import dev.cajeta.cloud.s3.S3ObjectStore;

/**
 * S3 through the AWS credential chain (adapters spec 2.1, 2.4): the
 * `S3ObjectStore` itself is `dev.cajeta.cloud.s3`'s, shared with every
 * S3-compatible provider; this is the AWS way of building one.
 */
public final class AwsS3 {
    /**
     * A store over `bucket` with the chain's credentials and region (`config`
     * may be null), at the default part size. `endpoint` is null for AWS
     * itself, or an S3-compatible service's base URL; `pathStyle` puts the
     * bucket in the path. A missing key or region throws
     * AwsConfigurationException naming the chain's steps; nothing is called
     * until the first operation.
     */
    public static #S3ObjectStore connect(String bucket, String endpoint, boolean pathStyle,
                                         AwsConfig config) {
        S3Credentials creds #= CredentialChain.resolve(config);
        String region #= CredentialChain.region(config);
        S3Endpoint where #= S3Endpoint.at(endpoint, region, pathStyle);
        S3Config c = heap S3Config(#where, bucket, #creds);
        return S3ObjectStore.open(c);
    }
}
