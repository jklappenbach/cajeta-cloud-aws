package dev.cajeta.cloud.aws;

import cajeta.lang.String;

/**
 * The text of a JSON string from its raw bytes: `JsonValue.asBytes()` keeps
 * escapes verbatim. Handles the two-character escapes and `\uXXXX`,
 * surrogate pairs included, encoding to UTF-8.
 */
final class JsonText {

    static #String unescape(int8[] b, int32 len) {
        int8[] out = heap int8[len < 1 ? 1 : len];
        int32 o = 0;
        int32 i = 0;
        while (i < len) {
            int8 c = b[i];
            if (c != (int8) 92 || i + 1 >= len) {
                out[o] = c;
                o = o + 1;
                i = i + 1;
                continue;
            }
            int8 e = b[i + 1];
            i = i + 2;
            if (e == (int8) 110) { out[o] = (int8) 10; o = o + 1; }
            else if (e == (int8) 116) { out[o] = (int8) 9; o = o + 1; }
            else if (e == (int8) 114) { out[o] = (int8) 13; o = o + 1; }
            else if (e == (int8) 98) { out[o] = (int8) 8; o = o + 1; }
            else if (e == (int8) 102) { out[o] = (int8) 12; o = o + 1; }
            else if (e == (int8) 117 && i + 4 <= len) {
                int32 cp = JsonText.hex4(b, i);
                i = i + 4;
                if (cp >= 0xD800 && cp < 0xDC00 && i + 6 <= len
                        && b[i] == (int8) 92 && b[i + 1] == (int8) 117) {
                    int32 lo = JsonText.hex4(b, i + 2);
                    if (lo >= 0xDC00 && lo < 0xE000) {
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                        i = i + 6;
                    }
                }
                o = JsonText.putUtf8(out, o, cp);
            } else {
                out[o] = e;   // \" \\ \/
                o = o + 1;
            }
        }
        return heap String(#out, o);
    }

    // A \u escape never grows the text: six bytes become at most three, and
    // a pair's twelve at most four.
    private static int32 putUtf8(int8[] out, int32 o, int32 cp) {
        if (cp < 0x80) {
            out[o] = (int8) cp;
            return o + 1;
        }
        if (cp < 0x800) {
            out[o] = (int8) (0xC0 | (cp >> 6));
            out[o + 1] = (int8) (0x80 | (cp & 0x3F));
            return o + 2;
        }
        if (cp < 0x10000) {
            out[o] = (int8) (0xE0 | (cp >> 12));
            out[o + 1] = (int8) (0x80 | ((cp >> 6) & 0x3F));
            out[o + 2] = (int8) (0x80 | (cp & 0x3F));
            return o + 3;
        }
        out[o] = (int8) (0xF0 | (cp >> 18));
        out[o + 1] = (int8) (0x80 | ((cp >> 12) & 0x3F));
        out[o + 2] = (int8) (0x80 | ((cp >> 6) & 0x3F));
        out[o + 3] = (int8) (0x80 | (cp & 0x3F));
        return o + 4;
    }

    private static int32 hex4(int8[] b, int32 at) {
        int32 v = 0;
        for (int32 k = 0; k < 4; k++) {
            int32 c = (int32) b[at + k];
            int32 d = 0;
            if (c >= 48 && c <= 57) d = c - 48;
            else if (c >= 97 && c <= 102) d = c - 87;
            else if (c >= 65 && c <= 70) d = c - 55;
            v = (v << 4) | d;
        }
        return v;
    }
}
