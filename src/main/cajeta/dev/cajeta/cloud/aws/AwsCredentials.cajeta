package dev.cajeta.cloud.aws;

import cajeta.lang.String;

/**
 * One AWS key pair, with the session token when the key is temporary (spec
 * 2.1). Immutable once built. `toString()` names the access key id only: the
 * secret and the token never reach a log line.
 */
public final class AwsCredentials {
    private String accessKeyId;
    private String secretAccessKey;
    private String sessionToken;
    private boolean hasToken;

    /** `sessionToken` may be null for a long-term key. */
    public AwsCredentials(String accessKeyId, String secretAccessKey, String sessionToken) {
        this.accessKeyId #= accessKeyId;
        this.secretAccessKey #= secretAccessKey;
        this.hasToken = sessionToken != null;
        if (this.hasToken) {
            this.sessionToken #= sessionToken;
        }
        return;
    }

    public String accessKeyId() {
        return this.accessKeyId;
    }

    public String secretAccessKey() {
        return this.secretAccessKey;
    }

    /** True when the key is temporary and `sessionToken()` must be sent. */
    public boolean hasSessionToken() {
        return this.hasToken;
    }

    /** The session token, or null for a long-term key. */
    public String sessionToken() {
        if (!this.hasToken) return null;
        return this.sessionToken;
    }

    public #String toString() {
        return "AwsCredentials(" + this.accessKeyId + ")";
    }
}
